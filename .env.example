# Copy to .env and export the values in your shell (or use your IDE's env file support).
# Django reads these with the standard os.environ mechanism.

# --- Required in production ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,boutique.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://boutique.example.com
DJANGO_SECURE_SSL_REDIRECT=True

# --- MySQL (set DB_ENGINE=mysql to use it; omitted -> local SQLite file) ---
DB_ENGINE=mysql
DB_NAME=vastra
DB_USER=vastra_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Boutique preferences ---
BOUTIQUE_PHONE=+91 98765 43210
BOUTIQUE_EMAIL=hello@vastra.example.com
BOUTIQUE_LOCATION=12 MG Road, Bengaluru, Karnataka 560001
BOUTIQUE_HOURS=Mon - Sun · 10:00 AM - 8:00 PM
