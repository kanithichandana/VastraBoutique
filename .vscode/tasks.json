{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vastra: Install dependencies",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe -m pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "Vastra: Migrations",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe manage.py migrate",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Vastra: Check",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe manage.py check",
      "problemMatcher": []
    },
    {
      "label": "Vastra: Test",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe manage.py test boutique -v 2",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Vastra: Runserver",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe manage.py runserver 127.0.0.1:8000 --noreload",
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
